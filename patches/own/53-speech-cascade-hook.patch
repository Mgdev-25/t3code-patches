+import * as crypto from "node:crypto";
+import * as fs from "node:fs";
+
+export interface SpeechCascadeConfig {
+  readonly url: string;
+  readonly tokenFile: string;
+}
+
+export interface SpeechCascadeHeader {
+  readonly language: string;
+  readonly vocabulary: readonly string[];
+  readonly silenceFiltering: boolean;
+}
+
+export type SpeechCascadeOutcome =
+  | {
+      readonly ok: true;
+      readonly text: string;
+      readonly tier: string;
+      readonly speechDetected: boolean;
+      readonly usedVocabulary: boolean;
+      readonly requestId: string;
+      readonly elapsedMs: number;
+    }
+  | {
+      readonly ok: false;
+      readonly reason: string;
+      readonly requestId: string;
+      readonly elapsedMs: number;
+    };
+
+export class SpeechCascadeAbortedError extends Error {
+  constructor(cause?: unknown) {
+    super("Speech cascade aborted by caller.", { cause });
+    this.name = "SpeechCascadeAbortedError";
+  }
+}
+
+const MAX_CASCADE_RESPONSE_BYTES = 256 * 1024;
+const LOOPBACK_HOSTS = new Set(["127.0.0.1", "localhost"]);
+
+let cachedToken: { readonly path: string; readonly mtimeMs: number; readonly value: string } | null =
+  null;
+
+export function resetSpeechCascadeTokenCacheForTests(): void {
+  cachedToken = null;
+}
+
+export function resolveSpeechCascadeConfig(
+  env: NodeJS.ProcessEnv = process.env,
+): SpeechCascadeConfig | { readonly invalidReason: string } | null {
+  const rawUrl = env.T3CODE_SPEECH_CASCADE_URL?.trim() ?? "";
+  const rawTokenFile = env.T3CODE_SPEECH_CASCADE_TOKEN_FILE?.trim() ?? "";
+  if (!rawUrl && !rawTokenFile) return null;
+  if (!rawUrl || !rawTokenFile) {
+    return {
+      invalidReason: "Both T3CODE_SPEECH_CASCADE_URL and T3CODE_SPEECH_CASCADE_TOKEN_FILE are required.",
+    };
+  }
+  let parsed: URL;
+  try {
+    parsed = new URL(rawUrl);
+  } catch {
+    return { invalidReason: "Invalid T3CODE_SPEECH_CASCADE_URL." };
+  }
+  if (parsed.protocol !== "http:" && parsed.protocol !== "https:") {
+    return { invalidReason: "T3CODE_SPEECH_CASCADE_URL must use http or https." };
+  }
+  if (!LOOPBACK_HOSTS.has(parsed.hostname.toLowerCase())) {
+    return { invalidReason: "T3CODE_SPEECH_CASCADE_URL must target 127.0.0.1 or localhost." };
+  }
+  return { url: parsed.toString(), tokenFile: rawTokenFile };
+}
+
+export function isSpeechCascadeConfigured(env: NodeJS.ProcessEnv = process.env): boolean {
+  const resolved = resolveSpeechCascadeConfig(env);
+  return resolved !== null && "url" in resolved;
+}
+
+export function isAllZeroPcm(pcm: Float32Array): boolean {
+  for (let index = 0; index < pcm.length; index += 1) {
+    if (pcm[index] !== 0) return false;
+  }
+  return true;
+}
+
+export function computeSpeechCascadeBudgetMs(audioSec: number): number {
+  const safeSec = Number.isFinite(audioSec) && audioSec > 0 ? audioSec : 0;
+  return Math.min(35_000, Math.max(18_000, Math.round(safeSec * 400) + 14_000));
+}
+
+export function encodeSpeechCascadeBody(
+  header: SpeechCascadeHeader,
+  pcmBytes: Uint8Array,
+): Uint8Array {
+  const headerBytes = new TextEncoder().encode(JSON.stringify(header));
+  const body = new Uint8Array(4 + headerBytes.byteLength + pcmBytes.byteLength);
+  new DataView(body.buffer).setUint32(0, headerBytes.byteLength, false);
+  body.set(headerBytes, 4);
+  body.set(pcmBytes, 4 + headerBytes.byteLength);
+  return body;
+}
+
+function readBearerToken(tokenFile: string): string {
+  // @effect-diagnostics-next-line nodeBuiltinImport:off
+  const stat = fs.statSync(tokenFile);
+  if (cachedToken && cachedToken.path === tokenFile && cachedToken.mtimeMs === stat.mtimeMs) {
+    return cachedToken.value;
+  }
+  const value = fs.readFileSync(tokenFile, "utf8").trim();
+  if (!value) throw new Error("Speech cascade token file is empty.");
+  cachedToken = { path: tokenFile, mtimeMs: stat.mtimeMs, value };
+  return value;
+}
+
+async function readBoundedText(response: Response, maxBytes: number): Promise<string> {
+  const contentLength = Number(response.headers.get("content-length"));
+  if (Number.isFinite(contentLength) && contentLength > maxBytes) {
+    throw new Error("response_too_large");
+  }
+  if (!response.body) {
+    const buffer = await response.arrayBuffer();
+    if (buffer.byteLength > maxBytes) throw new Error("response_too_large");
+    return new TextDecoder().decode(buffer);
+  }
+  const reader = response.body.getReader();
+  const chunks: Uint8Array[] = [];
+  let total = 0;
+  try {
+    while (true) {
+      const { done, value } = await reader.read();
+      if (done) break;
+      if (!value) continue;
+      total += value.byteLength;
+      if (total > maxBytes) {
+        await reader.cancel().catch(() => undefined);
+        throw new Error("response_too_large");
+      }
+      chunks.push(value);
+    }
+  } finally {
+    reader.releaseLock();
+  }
+  const merged = new Uint8Array(total);
+  let offset = 0;
+  for (const chunk of chunks) {
+    merged.set(chunk, offset);
+    offset += chunk.byteLength;
+  }
+  return new TextDecoder().decode(merged);
+}
+
+export async function transcribeViaSpeechCascade(input: {
+  readonly pcmBytes: Uint8Array;
+  readonly pcmSampleCount: number;
+  readonly header: SpeechCascadeHeader;
+  readonly signal: AbortSignal;
+  readonly env?: NodeJS.ProcessEnv;
+  readonly fetchImpl?: typeof fetch;
+  readonly budgetMsOverride?: number;
+}): Promise<SpeechCascadeOutcome> {
+  const startedAt = Date.now();
+  const requestId = crypto.randomUUID();
+  const resolved = resolveSpeechCascadeConfig(input.env ?? process.env);
+  if (!resolved) {
+    return { ok: false, reason: "not_configured", requestId, elapsedMs: Date.now() - startedAt };
+  }
+  if ("invalidReason" in resolved) {
+    return {
+      ok: false,
+      reason: `invalid_config:${resolved.invalidReason}`,
+      requestId,
+      elapsedMs: Date.now() - startedAt,
+    };
+  }
+  if (input.signal.aborted) {
+    throw new SpeechCascadeAbortedError(input.signal.reason);
+  }
+
+  let token: string;
+  try {
+    token = readBearerToken(resolved.tokenFile);
+  } catch {
+    return { ok: false, reason: "token_unreadable", requestId, elapsedMs: Date.now() - startedAt };
+  }
+
+  const audioSec = input.pcmSampleCount / 16_000;
+  const budgetMs = input.budgetMsOverride ?? computeSpeechCascadeBudgetMs(audioSec);
+  const body = encodeSpeechCascadeBody(input.header, input.pcmBytes);
+
+  // @effect-diagnostics-next-line abortControllerInEffect:off - Bounds remote cascade attempt independently of caller abort.
+  const timeoutController = new AbortController();
+  const timer = setTimeout(() => timeoutController.abort(new Error("cascade_timeout")), budgetMs);
+  const combinedSignal = AbortSignal.any([input.signal, timeoutController.signal]);
+  const fetchFn = input.fetchImpl ?? fetch;
+
+  try {
+    const response = await fetchFn(resolved.url, {
+      method: "POST",
+      headers: {
+        "Content-Type": "application/octet-stream",
+        Authorization: `Bearer ${token}`,
+        "X-Request-Id": requestId,
+        "X-Deadline-Ms": String(budgetMs),
+      },
+      body: new Uint8Array(body),
+      redirect: "error",
+      signal: combinedSignal,
+    });
+    if (input.signal.aborted) {
+      throw new SpeechCascadeAbortedError(input.signal.reason);
+    }
+    if (!response.ok) {
+      return {
+        ok: false,
+        reason: `http_${response.status}`,
+        requestId,
+        elapsedMs: Date.now() - startedAt,
+      };
+    }
+    const raw = await readBoundedText(response, MAX_CASCADE_RESPONSE_BYTES);
+    let parsed: unknown;
+    try {
+      parsed = JSON.parse(raw);
+    } catch {
+      return { ok: false, reason: "invalid_json", requestId, elapsedMs: Date.now() - startedAt };
+    }
+    if (typeof parsed !== "object" || parsed === null) {
+      return { ok: false, reason: "invalid_payload", requestId, elapsedMs: Date.now() - startedAt };
+    }
+    const record = parsed as Record<string, unknown>;
+    if (typeof record.text !== "string") {
+      return { ok: false, reason: "missing_text", requestId, elapsedMs: Date.now() - startedAt };
+    }
+    const tier = typeof record.tier === "string" && record.tier.trim() ? record.tier.trim() : "cascade";
+    const speechDetected = record.speechDetected !== false;
+    const usedVocabulary = record.usedVocabulary === true;
+    const trimmed = record.text.trim();
+    if (!speechDetected && trimmed === "") {
+      return {
+        ok: true,
+        text: "",
+        tier,
+        speechDetected: false,
+        usedVocabulary,
+        requestId,
+        elapsedMs: Date.now() - startedAt,
+      };
+    }
+    if (trimmed === "") {
+      return { ok: false, reason: "empty_text", requestId, elapsedMs: Date.now() - startedAt };
+    }
+    return {
+      ok: true,
+      text: record.text,
+      tier,
+      speechDetected: true,
+      usedVocabulary,
+      requestId,
+      elapsedMs: Date.now() - startedAt,
+    };
+  } catch (cause) {
+    if (cause instanceof SpeechCascadeAbortedError || input.signal.aborted) {
+      throw cause instanceof SpeechCascadeAbortedError
+        ? cause
+        : new SpeechCascadeAbortedError(input.signal.reason);
+    }
+    if (timeoutController.signal.aborted) {
+      return { ok: false, reason: "timeout", requestId, elapsedMs: Date.now() - startedAt };
+    }
+    const message = cause instanceof Error && cause.message === "response_too_large"
+      ? "response_too_large"
+      : "network_error";
+    return { ok: false, reason: message, requestId, elapsedMs: Date.now() - startedAt };
+  } finally {
+    clearTimeout(timer);
+  }
+}
