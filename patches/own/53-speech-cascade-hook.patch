+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vite-plus/test";
+import {
+  computeSpeechCascadeBudgetMs,
+  encodeSpeechCascadeBody,
+  isAllZeroPcm,
+  isSpeechCascadeConfigured,
+  resetSpeechCascadeTokenCacheForTests,
+  resolveSpeechCascadeConfig,
+  SpeechCascadeAbortedError,
+  transcribeViaSpeechCascade,
+} from "./cascade.ts";
+
+describe("speech cascade helper", () => {
+  let tmpDir: string;
+  let tokenFile: string;
+
+  beforeEach(() => {
+    resetSpeechCascadeTokenCacheForTests();
+    tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), "t3-cascade-test-"));
+    tokenFile = path.join(tmpDir, "laptop.token");
+    fs.writeFileSync(tokenFile, "secret-token-123\n", { mode: 0o600 });
+  });
+
+  afterEach(() => {
+    fs.rmSync(tmpDir, { recursive: true, force: true });
+    vi.restoreAllMocks();
+  });
+
+  it("validates loopback-only URL and requires both env variables", () => {
+    expect(resolveSpeechCascadeConfig({})).toBeNull();
+    expect(isSpeechCascadeConfigured({})).toBe(false);
+    expect(resolveSpeechCascadeConfig({ T3CODE_SPEECH_CASCADE_URL: "http://127.0.0.1:8179/transcribe" })).toEqual({
+      invalidReason: expect.stringContaining("Both"),
+    });
+    expect(
+      resolveSpeechCascadeConfig({
+        T3CODE_SPEECH_CASCADE_URL: "http://100.64.0.1:8179/transcribe",
+        T3CODE_SPEECH_CASCADE_TOKEN_FILE: tokenFile,
+      }),
+    ).toEqual({
+      invalidReason: expect.stringContaining("127.0.0.1 or localhost"),
+    });
+    expect(
+      resolveSpeechCascadeConfig({
+        T3CODE_SPEECH_CASCADE_URL: "http://127.0.0.1:8179/transcribe",
+        T3CODE_SPEECH_CASCADE_TOKEN_FILE: tokenFile,
+      }),
+    ).toEqual({
+      url: "http://127.0.0.1:8179/transcribe",
+      tokenFile,
+    });
+    expect(
+      isSpeechCascadeConfigured({
+        T3CODE_SPEECH_CASCADE_URL: "http://localhost:8179/transcribe",
+        T3CODE_SPEECH_CASCADE_TOKEN_FILE: tokenFile,
+      }),
+    ).toBe(true);
+  });
+
+  it("only treats all-zero PCM as digital silence", () => {
+    expect(isAllZeroPcm(new Float32Array([0, 0, 0]))).toBe(true);
+    expect(isAllZeroPcm(new Float32Array([0, 1e-6, 0]))).toBe(false);
+    expect(isAllZeroPcm(new Float32Array([-0.00001]))).toBe(false);
+  });
+
+  it("scales remote budget with audio duration and clamps between 18s and 35s", () => {
+    expect(computeSpeechCascadeBudgetMs(2)).toBe(18_000);
+    expect(computeSpeechCascadeBudgetMs(30)).toBe(26_000);
+    expect(computeSpeechCascadeBudgetMs(120)).toBe(35_000);
+    expect(computeSpeechCascadeBudgetMs(300)).toBe(35_000);
+  });
+
+  it("frames header JSON and raw PCM bytes cleanly", () => {
+    const pcm = new Uint8Array(new Float32Array([0.5, -0.5]).buffer);
+    const body = encodeSpeechCascadeBody(
+      { language: "fr", vocabulary: ["Delicity", "Selkies"], silenceFiltering: true },
+      pcm,
+    );
+    const headerLen = new DataView(body.buffer).getUint32(0, false);
+    const header = JSON.parse(new TextDecoder().decode(body.subarray(4, 4 + headerLen)));
+    expect(header).toEqual({
+      language: "fr",
+      vocabulary: ["Delicity", "Selkies"],
+      silenceFiltering: true,
+    });
+    expect([...new Float32Array(body.slice(4 + headerLen).buffer)]).toEqual([0.5, -0.5]);
+  });
+
+  it("returns ok with bearer token, headers, and explicit speechDetected false", async () => {
+    const pcm = new Uint8Array(new Float32Array(16_000).fill(0.1).buffer);
+    const fetchMock = vi.fn(async (_url: string | URL | Request, init?: RequestInit) => {
+      const headers = init?.headers as Record<string, string>;
+      expect(headers.Authorization).toBe("Bearer secret-token-123");
+      expect(headers["X-Deadline-Ms"]).toBe("18000");
+      expect(headers["X-Request-Id"]).toMatch(/^[0-9a-f-]{36}$/);
+      expect(init?.redirect).toBe("error");
+      return new Response(
+        JSON.stringify({
+          text: "",
+          tier: "gemini-3.5-transcribe",
+          speechDetected: false,
+          usedVocabulary: true,
+        }),
+        { status: 200, headers: { "Content-Type": "application/json" } },
+      );
+    });
+    const outcome = await transcribeViaSpeechCascade({
+      pcmBytes: pcm,
+      pcmSampleCount: 16_000,
+      header: { language: "auto", vocabulary: ["T3 Code"], silenceFiltering: true },
+      signal: new AbortController().signal,
+      env: {
+        T3CODE_SPEECH_CASCADE_URL: "http://127.0.0.1:8179/transcribe",
+        T3CODE_SPEECH_CASCADE_TOKEN_FILE: tokenFile,
+      },
+      fetchImpl: fetchMock as unknown as typeof fetch,
+    });
+    expect(outcome).toMatchObject({
+      ok: true,
+      text: "",
+      tier: "gemini-3.5-transcribe",
+      speechDetected: false,
+      usedVocabulary: true,
+    });
+  });
+
+  it("treats blank text without speechDetected false as a fallback failure", async () => {
+    const pcm = new Uint8Array(new Float32Array([0.2]).buffer);
+    const fetchMock = vi.fn(
+      async () =>
+        new Response(JSON.stringify({ text: "   ", tier: "omarchy-cloud" }), {
+          status: 200,
+          headers: { "Content-Type": "application/json" },
+        }),
+    );
+    const outcome = await transcribeViaSpeechCascade({
+      pcmBytes: pcm,
+      pcmSampleCount: 1,
+      header: { language: "auto", vocabulary: [], silenceFiltering: true },
+      signal: new AbortController().signal,
+      env: {
+        T3CODE_SPEECH_CASCADE_URL: "http://127.0.0.1:8179/transcribe",
+        T3CODE_SPEECH_CASCADE_TOKEN_FILE: tokenFile,
+      },
+      fetchImpl: fetchMock as unknown as typeof fetch,
+    });
+    expect(outcome).toMatchObject({ ok: false, reason: "empty_text" });
+  });
+
+  it("rejects oversized responses over 256 KiB and falls back", async () => {
+    const pcm = new Uint8Array(new Float32Array([0.2]).buffer);
+    const big = "x".repeat(300 * 1024);
+    const fetchMock = vi.fn(
+      async () => new Response(JSON.stringify({ text: big }), { status: 200 }),
+    );
+    const outcome = await transcribeViaSpeechCascade({
+      pcmBytes: pcm,
+      pcmSampleCount: 1,
+      header: { language: "auto", vocabulary: [], silenceFiltering: true },
+      signal: new AbortController().signal,
+      env: {
+        T3CODE_SPEECH_CASCADE_URL: "http://127.0.0.1:8179/transcribe",
+        T3CODE_SPEECH_CASCADE_TOKEN_FILE: tokenFile,
+      },
+      fetchImpl: fetchMock as unknown as typeof fetch,
+    });
+    expect(outcome).toMatchObject({ ok: false, reason: "response_too_large" });
+  });
+
+  it("returns timeout on budget expiry but throws SpeechCascadeAbortedError on caller abort", async () => {
+    const pcm = new Uint8Array(new Float32Array([0.2]).buffer);
+    const hangingFetch = vi.fn(
+      (_url: string | URL | Request, init?: RequestInit) =>
+        new Promise<Response>((_resolve, reject) => {
+          init?.signal?.addEventListener("abort", () => reject(init.signal?.reason ?? new Error("aborted")));
+        }),
+    );
+
+    const timeoutOutcome = await transcribeViaSpeechCascade({
+      pcmBytes: pcm,
+      pcmSampleCount: 1,
+      header: { language: "auto", vocabulary: [], silenceFiltering: true },
+      signal: new AbortController().signal,
+      env: {
+        T3CODE_SPEECH_CASCADE_URL: "http://127.0.0.1:8179/transcribe",
+        T3CODE_SPEECH_CASCADE_TOKEN_FILE: tokenFile,
+      },
+      fetchImpl: hangingFetch as unknown as typeof fetch,
+      budgetMsOverride: 25,
+    });
+    expect(timeoutOutcome).toMatchObject({ ok: false, reason: "timeout" });
+
+    const caller = new AbortController();
+    setTimeout(() => caller.abort(new Error("user_cancelled")), 15);
+    await expect(
+      transcribeViaSpeechCascade({
+        pcmBytes: pcm,
+        pcmSampleCount: 1,
+        header: { language: "auto", vocabulary: [], silenceFiltering: true },
+        signal: caller.signal,
+        env: {
+          T3CODE_SPEECH_CASCADE_URL: "http://127.0.0.1:8179/transcribe",
+          T3CODE_SPEECH_CASCADE_TOKEN_FILE: tokenFile,
+        },
+        fetchImpl: hangingFetch as unknown as typeof fetch,
+        budgetMsOverride: 5_000,
+      }),
+    ).rejects.toBeInstanceOf(SpeechCascadeAbortedError);
+  });
+});
