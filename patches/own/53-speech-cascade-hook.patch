+      fs.writeFileSync(tokenFile, "svc-secret\n", { mode: 0o600 });
+      let handler: CascadeHandler = (_req, res) => {
+        res.writeHead(503);
+        res.end("unconfigured");
+      };
+      const server = http.createServer((req, res) => handler(req, res));
+      await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+      const port = (server.address() as { port: number }).port;
+      const prevUrl = process.env.T3CODE_SPEECH_CASCADE_URL;
+      const prevToken = process.env.T3CODE_SPEECH_CASCADE_TOKEN_FILE;
+      process.env.T3CODE_SPEECH_CASCADE_URL = `http://127.0.0.1:${port}/transcribe`;
+      process.env.T3CODE_SPEECH_CASCADE_TOKEN_FILE = tokenFile;
+      return {
+        dir,
+        server,
+        prevUrl,
+        prevToken,
+        setHandler: (fn: CascadeHandler) => {
+          handler = fn;
+        },
+      };
+    }),
+    ({ setHandler }) => effect(setHandler),
+    ({ dir, server, prevUrl, prevToken }) =>
+      Effect.promise(async () => {
+        if (prevUrl === undefined) delete process.env.T3CODE_SPEECH_CASCADE_URL;
+        else process.env.T3CODE_SPEECH_CASCADE_URL = prevUrl;
+        if (prevToken === undefined) delete process.env.T3CODE_SPEECH_CASCADE_TOKEN_FILE;
+        else process.env.T3CODE_SPEECH_CASCADE_TOKEN_FILE = prevToken;
+        resetSpeechCascadeTokenCacheForTests();
+        server.closeAllConnections();
+        await new Promise<void>((resolve) => server.close(() => resolve()));
