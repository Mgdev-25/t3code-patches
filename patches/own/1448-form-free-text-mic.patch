+          ? { phase: "recording", error: null, errorAction: null }
+          : { phase: "idle", error: null, errorAction: null },
+      audioLevels: { value: [] },
+      elapsedSeconds: harness.phase === "recording" ? 2 : 0,
+      freezesEditor: harness.phase === "recording",
+      start: () => {
+        harness.started++;
+        harness.events.push("voice.start");
+      },
+      stop: () => {
+        harness.stopped++;
+        harness.events.push("voice.stop");
+      },
+      cancel: () => {
+        harness.cancelled++;
+        harness.events.push("voice.cancel");
+      },
+    };
+  },
+}));
+
+import { QuestionAttachments } from "./QuestionAttachments";
+
+function setup(options?: { readonly hidden?: boolean }) {
+  (globalThis as { IS_REACT_ACT_ENVIRONMENT?: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+  harness.voice = null;
+  harness.started = 0;
+  harness.stopped = 0;
+  harness.cancelled = 0;
+  harness.keyboardDismissed = 0;
+  harness.events = [];
+  harness.toolbarMounted = 0;
+  const question = {
+    id: "question-1",
+    header: "Answer",
+    question: "Type your answer",
+    options: [],
+    multiSelect: false,
+  } as UserInputQuestion;
+  const changes: string[] = [];
+  const focus: boolean[] = [];
+  const container = document.body.appendChild(document.createElement("div"));
+  const root = createRoot(container);
+  act(() =>
+    root.render(
+      <QuestionAttachments
+        requestId="request-1"
+        question={question}
+        questions={[question]}
+        disabled={false}
+        hidden={options?.hidden}
+        value=""
+        onChangeText={(text) => changes.push(text)}
+        onInputFocusChange={(focused) => focus.push(focused)}
+      />,
+    ),
+  );
+  const input = () => container.querySelector("input")!;
+  return {
+    changes,
+    container,
+    focus,
+    input,
+    voice: () => harness.voice!,
+    pressMic: () => {
+      const mic = [...container.querySelectorAll("button")].find(
+        (button) => button.textContent === "Start voice input",
+      );
+      if (!mic) throw new Error("No mic button");
+      act(() => mic.click());
+    },
+    type: (text: string) => {
+      const setValue = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, "value")!.set!;
+      act(() => {
+        setValue.call(input(), text);
+        input().dispatchEvent(new Event("input", { bubbles: true }));
+      });
+    },
+    unmount: () => {
+      act(() => root.unmount());
+      container.remove();
+    },
+  };
+}
+
+it("dictates into the free-text answer of a question", () => {
+  const screen = setup();
+
+  screen.pressMic();
+  expect(harness.started).toBe(1);
+  expect(screen.voice().ownerKey).toBe("env-1:thread-1:request-1:question-1");
+
+  act(() => screen.input().focus());
+  screen.type("Check ");
+  expect(screen.voice().readDraftMessage()).toBe("Check ");
+  expect(screen.voice().selection).toEqual({ start: 6, end: 6 });
+
+  act(() => screen.voice().onChangeDraftMessage("Check Selkies."));
+  expect(screen.input().value).toBe("Check Selkies.");
+  expect(screen.changes.at(-1)).toBe("Check Selkies.");
+  expect(screen.voice().readDraftMessage()).toBe("Check Selkies.");
+  // The new input is not focused, so the card must not keep the keyboard.
+  expect(screen.focus).toEqual([true, false]);
+
+  screen.unmount();
+});
+
+it("takes no transcript after the answer field unmounts", () => {
+  const screen = setup();
+  const voice = screen.voice();
+
+  screen.unmount();
+
+  expect(voice.readDraftMessage()).toBeNull();
+  voice.onChangeDraftMessage("late");
+  expect(screen.changes).toEqual([]);
+});
+
+it("forwards hidden state to useVoiceInputController for collapsed cards", () => {
+  const expanded = setup({ hidden: false });
+  expect(expanded.voice().hidden).toBe(false);
+  expanded.unmount();
+
+  const collapsed = setup({ hidden: true });
+  expect(collapsed.voice().hidden).toBe(true);
+  collapsed.unmount();
+});
+
+it("renders active dictation controls inline without ComposerDictationToolbar", () => {
+  harness.phase = "recording";
+  const screen = setup();
+  try {
+    expect(harness.toolbarMounted).toBe(0);
+    const buttons = [...screen.container.querySelectorAll("button")];
+    expect(buttons.find((button) => button.textContent === "Start voice input")).toBeUndefined();
+    const cancel = buttons.find((button) => button.textContent === "Cancel dictation");
+    const finish = buttons.find((button) => button.textContent === "Finish dictation");
+    expect(cancel).toBeTruthy();
+    expect(finish).toBeTruthy();
+    expect(screen.container.textContent).toContain("Recording 0:02");
+
+    act(() => finish!.click());
+    expect(harness.stopped).toBe(1);
+    act(() => cancel!.click());
+    expect(harness.cancelled).toBe(1);
+    expect(harness.events).toEqual([
+      "keyboard.dismiss",
+      "voice.stop",
+      "keyboard.dismiss",
+      "voice.cancel",
+    ]);
+  } finally {
+    harness.phase = "idle";
+    screen.unmount();
+  }
+});
+
+it("blurs the focused input and dismisses the keyboard before starting dictation", () => {
+  const screen = setup();
+  act(() => screen.input().focus());
+  expect(document.activeElement).toBe(screen.input());
+  expect(screen.focus).toEqual([true]);
+
+  screen.pressMic();
+
+  expect(document.activeElement).not.toBe(screen.input());
+  expect(screen.focus).toEqual([true, false]);
+  expect(harness.events).toEqual(["keyboard.dismiss", "voice.start"]);
+
+  screen.unmount();
+});
