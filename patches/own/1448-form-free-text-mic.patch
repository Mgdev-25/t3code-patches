diff --git a/apps/mobile/src/features/threads/QuestionAttachments.voice.test.tsx b/apps/mobile/src/features/threads/QuestionAttachments.voice.test.tsx
new file mode 100644
index 0000000000..12b9a555e6
--- /dev/null
+++ b/apps/mobile/src/features/threads/QuestionAttachments.voice.test.tsx
@@ -0,0 +1,202 @@
+import type { UserInputQuestion } from "@t3tools/contracts";
+import type { ReactNode } from "react";
+import { act, forwardRef } from "react";
+import { createRoot } from "react-dom/client";
+import { expect, it, vi } from "vite-plus/test";
+
+type VoiceInput = {
+  readonly ownerKey: string | null;
+  readonly readDraftMessage: () => string | null;
+  readonly selection: { start: number; end: number };
+  readonly onChangeDraftMessage: (text: string) => void;
+};
+
+const harness = vi.hoisted(() => ({
+  voice: null as VoiceInput | null,
+  started: 0,
+}));
+
+type Children = { children?: ReactNode };
+
+vi.mock("react-native", () => ({
+  View: ({ children }: Children) => <div>{children}</div>,
+}));
+vi.mock("expo-paste-input", () => ({
+  TextInputWrapper: ({ children }: Children) => <div>{children}</div>,
+}));
+vi.mock("../../components/ui/AppText", () => ({
+  AppTextInput: forwardRef<
+    HTMLInputElement,
+    {
+      defaultValue: string;
+      editable: boolean;
+      onChangeText: (text: string) => void;
+      onSelectionChange: (event: {
+        nativeEvent: { selection: { start: number; end: number } };
+      }) => void;
+      onFocus: () => void;
+      onBlur: () => void;
+    }
+  >((props, ref) => (
+    <input
+      ref={ref}
+      aria-label="answer"
+      defaultValue={props.defaultValue}
+      readOnly={!props.editable}
+      onFocus={props.onFocus}
+      onBlur={props.onBlur}
+      onChange={(event) => {
+        props.onChangeText(event.target.value);
+        const end = event.target.value.length;
+        props.onSelectionChange({ nativeEvent: { selection: { start: end, end } } });
+      }}
+    />
+  )),
+}));
+vi.mock("../../components/ui/Dialog", () => ({ alert: () => {} }));
+vi.mock("../../lib/useNativePaste", () => ({ useNativePaste: () => () => {} }));
+vi.mock("../../lib/composerImages", () => ({}));
+vi.mock("@effect/atom-react", () => ({ useAtomValue: () => ({}) }));
+vi.mock("./ComposerAttachmentButton", () => ({ ComposerAttachmentButton: () => null }));
+vi.mock("../../components/ComposerAttachmentStrip", () => ({
+  ComposerAttachmentStrip: () => null,
+}));
+vi.mock("../../components/ui/FilePreviewModal", () => ({ FilePreviewModal: () => null }));
+vi.mock("../../components/ui/VideoPreviewModal", () => ({ VideoPreviewModal: () => null }));
+vi.mock("@react-navigation/native", () => ({ useNavigation: () => ({}) }));
+vi.mock("../../state/use-thread-selection", () => ({
+  useThreadSelection: () => ({ selectedThread: { environmentId: "env-1", id: "thread-1" } }),
+}));
+vi.mock("../../state/entities", () => ({ useServerConfigs: () => new Map() }));
+vi.mock("../../state/atom-registry", () => ({ appAtomRegistry: { get: () => ({}) } }));
+vi.mock("../../state/use-composer-drafts", () => ({
+  composerDraftsAtom: {},
+  appendComposerDraftAttachments: () => 0,
+  removeComposerDraftAttachment: () => {},
+  releaseUnusedComposerAttachmentFiles: async () => {},
+}));
+vi.mock("../../state/question-attachments", () => ({
+  changeQuestionAttachmentPreparation: () => {},
+  questionAttachmentPreparationAtom: {},
+  questionAttachmentDraftKey: (...parts: string[]) => parts.join(":"),
+}));
+vi.mock("../voice-input/voiceInputPresentation", () => ({
+  resolveVoiceComposerPresentation: () => ({ statusKind: "idle" }),
+}));
+vi.mock("../voice-input/ComposerDictationControl", () => ({
+  ComposerDictationStartAction: (props: { onStart: () => void }) => (
+    <button type="button" onClick={props.onStart}>
+      Start voice input
+    </button>
+  ),
+  ComposerDictationError: () => null,
+  ComposerDictationToolbar: () => null,
+  ComposerDictationCancelAction: () => null,
+  ComposerDictationStatus: () => null,
+  ComposerDictationPrimaryAction: () => null,
+}));
+vi.mock("../voice-input/useVoiceInputController", () => ({
+  useVoiceInputController: (input: VoiceInput) => {
+    harness.voice = input;
+    return {
+      isAvailable: true,
+      state: { phase: "idle", error: null, errorAction: null },
+      audioLevels: { value: [] },
+      elapsedSeconds: 0,
+      freezesEditor: false,
+      start: () => harness.started++,
+      stop: () => {},
+      cancel: () => {},
+    };
+  },
+}));
+
+import { QuestionAttachments } from "./QuestionAttachments";
+
+function setup() {
+  (globalThis as { IS_REACT_ACT_ENVIRONMENT?: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+  harness.voice = null;
+  harness.started = 0;
+  const question = {
+    id: "question-1",
+    header: "Answer",
+    question: "Type your answer",
+    options: [],
+    multiSelect: false,
+  } as UserInputQuestion;
+  const changes: string[] = [];
+  const focus: boolean[] = [];
+  const container = document.body.appendChild(document.createElement("div"));
+  const root = createRoot(container);
+  act(() =>
+    root.render(
+      <QuestionAttachments
+        requestId="request-1"
+        question={question}
+        questions={[question]}
+        disabled={false}
+        value=""
+        onChangeText={(text) => changes.push(text)}
+        onInputFocusChange={(focused) => focus.push(focused)}
+      />,
+    ),
+  );
+  const input = () => container.querySelector("input")!;
+  return {
+    changes,
+    focus,
+    input,
+    voice: () => harness.voice!,
+    pressMic: () => {
+      const mic = [...container.querySelectorAll("button")].find(
+        (button) => button.textContent === "Start voice input",
+      );
+      if (!mic) throw new Error("No mic button");
+      act(() => mic.click());
+    },
+    type: (text: string) => {
+      const setValue = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, "value")!.set!;
+      act(() => {
+        setValue.call(input(), text);
+        input().dispatchEvent(new Event("input", { bubbles: true }));
+      });
+    },
+    unmount: () => {
+      act(() => root.unmount());
+      container.remove();
+    },
+  };
+}
+
+it("dictates into the free-text answer of a question", () => {
+  const screen = setup();
+
+  screen.pressMic();
+  expect(harness.started).toBe(1);
+  expect(screen.voice().ownerKey).toBe("env-1:thread-1:request-1:question-1");
+
+  act(() => screen.input().focus());
+  screen.type("Check ");
+  expect(screen.voice().readDraftMessage()).toBe("Check ");
+  expect(screen.voice().selection).toEqual({ start: 6, end: 6 });
+
+  act(() => screen.voice().onChangeDraftMessage("Check Selkies."));
+  expect(screen.input().value).toBe("Check Selkies.");
+  expect(screen.changes.at(-1)).toBe("Check Selkies.");
+  expect(screen.voice().readDraftMessage()).toBe("Check Selkies.");
+  // The new input is not focused, so the card must not keep the keyboard.
+  expect(screen.focus).toEqual([true, false]);
+
+  screen.unmount();
+});
+
+it("takes no transcript after the answer field unmounts", () => {
+  const screen = setup();
+  const voice = screen.voice();
+
+  screen.unmount();
+
+  expect(voice.readDraftMessage()).toBeNull();
+  voice.onChangeDraftMessage("late");
+  expect(screen.changes).toEqual([]);
+});
