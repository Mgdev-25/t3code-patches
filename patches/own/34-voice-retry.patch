+
+/** Published whenever a draft or question form is cleared, sent, or pruned, even if empty. */
+export const composerDraftResetEventAtom = Atom.make<ComposerDraftResetEvent | null>(null).pipe(
+  Atom.withLabel("mobile:composer-draft-reset-event"),
+);
+
+export function notifyComposerDraftReset(target: string | ((ownerKey: string) => boolean)): void {
+  const matches = typeof target === "string" ? (ownerKey: string) => ownerKey === target : target;
