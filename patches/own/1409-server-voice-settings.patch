diff --git a/apps/mobile/src/features/voice-input/voiceServerSettings.test.ts b/apps/mobile/src/features/voice-input/voiceServerSettings.test.ts
new file mode 100644
index 0000000000..4c9798b2c3
--- /dev/null
+++ b/apps/mobile/src/features/voice-input/voiceServerSettings.test.ts
@@ -0,0 +1,219 @@
+import { EnvironmentId, type SpeechCustomWords } from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import { Atom, AsyncResult } from "effect/reactivity";
+import { beforeEach, expect, it, vi } from "vite-plus/test";
+import { appAtomRegistry } from "../../state/atom-registry";
+import { environmentPresentations } from "../../state/presentation";
+import {
+  VoiceInputController,
+  resetVoiceInputGlobalsForTests,
+} from "../../../../../packages/client-runtime/src/voice-input/controller";
+import {
+  chooseVoiceDestination,
+  postProcessVoiceTranscript,
+  voiceRouteAtom,
+} from "./voiceDestination";
+
+const mocks = vi.hoisted(() => ({
+  transcribe: vi.fn(),
+  cloudTranscribe: vi.fn(),
+  cleanup: vi.fn(),
+}));
+const words: SpeechCustomWords = [{ term: "ShellBug1409", aliases: ["shell bug"] }];
+
+vi.mock("@t3tools/client-runtime/voice-input", async () => ({
+  ...(await import("../../../../../packages/client-runtime/src/voice-input/transcription")),
+  ...(await import("../../../../../packages/client-runtime/src/voice-input/controller")),
+  getEnvironmentSpeechStatus: () => Effect.succeed({ supported: true, state: "ready" }),
+  requireCloudSpeechKey: () => Effect.void,
+  transcribeEnvironmentPcm: mocks.transcribe,
+  transcribeCloudPcm: mocks.cloudTranscribe,
+  postProcessEnvironmentTranscript: mocks.cleanup,
+}));
+vi.mock("expo", () => ({
+  requireOptionalNativeModule: () => ({ decodeRecording: async () => new Uint8Array([0, 0]) }),
+}));
+vi.mock("expo/fetch", () => ({ fetch: vi.fn() }));
+vi.mock("./voiceGrantStorage", () => ({
+  readVoiceGrant: async () => null,
+  writeVoiceGrant: vi.fn(),
+}));
+vi.mock("../../lib/uuid", () => ({ uuidv4: () => "voice-settings-test" }));
+vi.mock("../../state/preferences", () => ({
+  mobilePreferencesAtom: Atom.make(AsyncResult.success({ speechLanguage: "fr" })),
+}));
+vi.mock("../../connection/runtime", async () => ({
+  connectionAtomRuntime: Atom.runtime((await import("effect/http")).FetchHttpClient.layer),
+}));
+vi.mock("../../state/presentation", () => ({
+  environmentPresentations: {
+    presentationAtom: Atom.family((id: string) =>
+      Atom.make({
+        connection: { phase: "connected" },
+        serverConfig: {
+          environment: {
+            capabilities: { voiceTranscription: true, cloudVoiceTranscription: true },
+          },
+          settings: {
+            speechProjectCustomWords: words,
+            speechPostProcessingModelSelection: id === "cleanup-off" ? null : { provider: "test" },
+          },
+        },
+      }),
+    ),
+  },
+}));
+vi.mock("../../state/session", async () => {
+  const Option = await import("effect/Option");
+  return {
+    environmentSession: {
+      preparedConnectionValueAtom: Atom.family((environmentId: string) =>
+        Atom.make(Option.some({ environmentId })),
+      ),
+      sessionStateAtom: Atom.family(() => Atom.make(true)),
+    },
+    sessionHasScope: () => true,
+  };
+});
+
+beforeEach(() => {
+  appAtomRegistry.reset();
+  resetVoiceInputGlobalsForTests();
+  vi.clearAllMocks();
+  mocks.transcribe.mockReturnValue(Effect.succeed({ text: "please check shell bug" }));
+  mocks.cloudTranscribe.mockReturnValue(Effect.succeed({ text: "please check shell bug" }));
+  mocks.cleanup.mockReturnValue(Effect.succeed({ text: "Please check ShellBug1409." }));
+});
+
+it("sends the Project dictionary and keeps the phone language for environment transcription", async () => {
+  chooseVoiceDestination(EnvironmentId.make("cleanup-on"));
+  const unmount = appAtomRegistry.mount(voiceRouteAtom);
+  try {
+    const options = { signal: new AbortController().signal };
+    const recording = await appAtomRegistry.get(voiceRouteAtom)!.transcriber!.prepare(options);
+    await recording.transcribe("file:///voice.m4a", options);
+    expect(mocks.transcribe.mock.calls[0]?.[2]).toMatchObject({
+      speechCustomWords: words,
+      speechLanguage: "fr",
+    });
+  } finally {
+    unmount();
+  }
+});
+
+it.each([
+  ["cleanup-on", undefined, "Please check ShellBug1409.", true],
+  ["cleanup-off", undefined, "please check shell bug", false],
+  ["cleanup-on", "openai", "please check shell bug", false],
+] as const)("inserts the expected transcript for %s with cloud provider %s", async (id, provider, expected, cleanup) => {
+  chooseVoiceDestination(EnvironmentId.make(id), provider);
+  const unmount = appAtomRegistry.mount(voiceRouteAtom);
+  const commitDraft = vi.fn();
+  const controller = new VoiceInputController({
+    recorder: {
+      uri: "file:///voice.m4a",
+      prepareToRecordAsync: async () => {},
+      record: () => {},
+      stop: async () => {},
+    },
+    getTranscriber: () => appAtomRegistry.get(voiceRouteAtom)?.transcriber ?? null,
+    postProcess: postProcessVoiceTranscript,
+    requestPermission: async () => ({ granted: true, canAskAgain: true }),
+    configureRecording: async () => {},
+    releaseRecording: async () => {},
+    deleteRecording: () => {},
+    readDraft: () => ({ ownerKey: "test", text: "", selection: { start: 0, end: 0 } }),
+    commitDraft,
+    onStateChange: () => {},
+  });
+  try {
+    await controller.start();
+    await controller.stop();
+    expect(commitDraft.mock.calls[0]?.[0]).toBe(expected);
+    if (cleanup) {
+      expect(mocks.cleanup).toHaveBeenCalledWith(
+        expect.objectContaining({ environmentId: EnvironmentId.make(id) }),
+        "please check shell bug",
+        { text: "", selection: { start: 0, end: 0 } },
+        {
+          speechCustomWords: words,
+          speechPostProcessingPrompt: { mode: "default", customInstructions: "" },
+        },
+        expect.any(Function),
+      );
+    } else {
+      expect(mocks.cleanup).not.toHaveBeenCalled();
+    }
+    if (provider) {
+      expect(mocks.cloudTranscribe.mock.calls[0]?.[3]).toMatchObject({
+        speechCustomWords: [],
+        speechLanguage: "fr",
+      });
+    }
+  } finally {
+    controller.dispose();
+    unmount();
+  }
+});
+
+it("keeps the raw transcript when cleanup fails", async () => {
+  mocks.cleanup.mockReturnValue(Effect.fail({ _tag: "CleanupUnavailable" as const }));
+  chooseVoiceDestination(EnvironmentId.make("cleanup-on"));
+  const unmount = appAtomRegistry.mount(voiceRouteAtom);
+  const commitDraft = vi.fn();
+  const controller = new VoiceInputController({
+    recorder: {
+      uri: "file:///voice.m4a",
+      prepareToRecordAsync: async () => {},
+      record: () => {},
+      stop: async () => {},
+    },
+    getTranscriber: () => appAtomRegistry.get(voiceRouteAtom)?.transcriber ?? null,
+    postProcess: postProcessVoiceTranscript,
+    requestPermission: async () => ({ granted: true, canAskAgain: true }),
+    configureRecording: async () => {},
+    releaseRecording: async () => {},
+    deleteRecording: () => {},
+    readDraft: () => ({ ownerKey: "test", text: "", selection: { start: 0, end: 0 } }),
+    commitDraft,
+    onStateChange: () => {},
+  });
+  try {
+    await controller.start();
+    await controller.stop();
+    expect(mocks.cleanup).toHaveBeenCalledOnce();
+    expect(commitDraft.mock.calls[0]?.[0]).toBe("please check shell bug");
+  } finally {
+    controller.dispose();
+    unmount();
+  }
+});
+
+it("keeps the recording route when the server config changes, and sends the newest dictionary", async () => {
+  chooseVoiceDestination(EnvironmentId.make("cleanup-on"));
+  const unmount = appAtomRegistry.mount(voiceRouteAtom);
+  try {
+    const route = appAtomRegistry.get(voiceRouteAtom);
+    // The mock presentation is a writable atom. A config event decodes a new settings object.
+    const presentation = environmentPresentations.presentationAtom(
+      EnvironmentId.make("cleanup-on"),
+    ) as unknown as Atom.Writable<{ serverConfig: { settings: object } }>;
+    const current = appAtomRegistry.get(presentation);
+    const newWords: SpeechCustomWords = [{ term: "Selkies", aliases: ["sell keys"] }];
+    appAtomRegistry.set(presentation, {
+      ...current,
+      serverConfig: {
+        ...current.serverConfig,
+        settings: { ...current.serverConfig.settings, speechProjectCustomWords: newWords },
+      },
+    });
+    // A new route cancels the recording in progress, so the route must stay the same.
+    expect(appAtomRegistry.get(voiceRouteAtom)).toBe(route);
+    const options = { signal: new AbortController().signal };
+    const recording = await route!.transcriber!.prepare(options);
+    await recording.transcribe("file:///voice.m4a", options);
+    expect(mocks.transcribe.mock.calls[0]?.[2]).toMatchObject({ speechCustomWords: newWords });
+  } finally {
+    unmount();
+  }
+});
