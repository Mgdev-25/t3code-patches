+export function postProcessVoiceTranscript(
+  transcript: string,
+  { signal }: { readonly signal: AbortSignal },
+): Promise<string> | null {
+  const grant = appAtomRegistry.get(voiceGrantAtom);
+  if (grant?.destination.kind !== "environment") return null;
+  const id = grant.destination.environmentId;
+  const connectionAtom = voiceConnectionAtom(id);
+  const connection = appAtomRegistry.get(connectionAtom);
+  const settings = appAtomRegistry.get(environmentPresentations.presentationAtom(id))?.serverConfig
+    ?.settings;
+  if (!connection || settings?.speechPostProcessingModelSelection == null) return null;
+  const canSend = () =>
+    appAtomRegistry.get(voiceGrantAtom) === grant &&
+    appAtomRegistry.get(connectionAtom) === connection;
+  return runSpeech(
+    postProcessEnvironmentTranscript(
+      connection,
+      transcript,
+      { text: "", selection: { start: 0, end: 0 } },
+      {
+        speechCustomWords: settings.speechProjectCustomWords,
+        speechPostProcessingPrompt: { mode: "default", customInstructions: "" },
+      },
+      canSend,
+    ),
+    signal,
+    canSend,
+  ).then((result) => result.text);
+}
