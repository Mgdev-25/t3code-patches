diff --git a/apps/server/src/orchestration-v2/pullRequestWatch.ts b/apps/server/src/orchestration-v2/pullRequestWatch.ts
index 5999996e..9d327391 100644
--- a/apps/server/src/orchestration-v2/pullRequestWatch.ts
+++ b/apps/server/src/orchestration-v2/pullRequestWatch.ts
@@ -11,6 +11,27 @@ import * as DateTime from "effect/DateTime";
 export const PULL_REQUEST_WATCH_WAKE_LIMIT = 10;
 /** How long a head may go without any check before the agent is told none reported. */
 export const PULL_REQUEST_WATCH_NO_CHECKS_MS = 15 * 60_000;
+/** Checks take minutes; faster sweeps of quiet watches waste the account's shared host quota. */
+export const PULL_REQUEST_WATCH_SWEEP_MS = 2 * 60_000;
+/** While a watched pull request runs checks, sweep this often so a finished check wakes sooner. */
+export const PULL_REQUEST_WATCH_PENDING_SWEEP_MS = 30_000;
+
+/**
+ * Whether a sweep tick reads the host. The reactor ticks every pending-sweep interval; a tick
+ * sweeps while a watched pull request runs checks, and else only once the quiet interval passed.
+ */
+export function pullRequestWatchSweepDue(input: {
+  readonly now: number;
+  readonly sweptAt: number | null;
+  readonly checksRunning: boolean;
+}): boolean {
+  if (input.sweptAt === null) return true;
+  const gap = input.checksRunning
+    ? PULL_REQUEST_WATCH_PENDING_SWEEP_MS
+    : PULL_REQUEST_WATCH_SWEEP_MS;
+  return input.now - input.sweptAt >= gap;
+}
