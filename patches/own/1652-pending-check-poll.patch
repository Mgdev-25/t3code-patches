+describe("pullRequestWatchSweepDue", () => {
+  const sweptAt = 1_000_000;
+
+  it("sweeps on the first tick", () => {
+    assert.isTrue(pullRequestWatchSweepDue({ now: 0, sweptAt: null, checksRunning: false }));
