diff --git a/packages/provider-muse/src/server/usageLimits.ts b/packages/provider-muse/src/server/usageLimits.ts
index 881c577390..df24a6b0a2 100644
--- a/packages/provider-muse/src/server/usageLimits.ts
+++ b/packages/provider-muse/src/server/usageLimits.ts
@@ -128,9 +128,21 @@ export function nextMuseUsageAccount(
 ): MuseUsageAccount {
   const identity =
     auth.status === "unauthenticated" || auth.type === "apiKey" ? null : museUsageAccount(auth);
-  if (identity === undefined || identity === account.identity) return account;
+  if (identity === undefined) {
+    // A confirmed accountLogin without email or label lost its verified identity:
+    // start a new generation so reports from the previous named login are never kept.
+    if (
+      auth.status === "authenticated" &&
+      auth.type === "accountLogin" &&
+      typeof account.identity === "string"
+    ) {
+      return { generation: account.generation + 1, identity: undefined };
+    }
+    return account;
+  }
+  if (identity === account.identity) return account;
   // The first login a check names is the one the hosts so far started under.
-  if (account.identity === undefined) return { ...account, identity };
+  if (account.generation === 0 && account.identity === undefined) return { ...account, identity };
   return { generation: account.generation + 1, identity };
 }
 
