+            state: {
+              account: yield* Ref.make<MuseUsageAccount>(account),
+              latestUsage: yield* Ref.make<MuseUsageReport | undefined>(afterReboot.latestUsage),
+              permit: yield* Semaphore.make(1),
+              cache: restoredCache,
+            },
+          });
+          expect(updated.provider.usageLimits?.windows[0]?.usedPercent).toBe(19);
+          expect(
+            (yield* restoredCache.read(provider.auth, observedAtMs + 120_000))?.window.usedPercent,
+          ).toBe(19);
+        }),
+      ),
+  );
 });
