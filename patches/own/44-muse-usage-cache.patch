index 0000000000..83e66302ea
--- /dev/null
+++ b/packages/provider-muse/src/server/usageCache.test.ts
@@ -0,0 +1,161 @@
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import { expect, it } from "@effect/vitest";
+import type { ServerProviderAuth } from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Path from "effect/Path";
+
+import type { MuseSubscriptionUsage } from "./protocol.ts";
+import {
+  makeMuseUsageCache,
+  museUsageCacheFilePath,
+  verifiedMuseAccountIdentity,
+} from "./usageCache.ts";
+
+const observedAtMs = 1793073851130;
+const usage: MuseSubscriptionUsage = {
+  observedAtMs,
+  tier: "Muse Code Power Usage",
+  window: { usedPercent: 42, windowDurationMins: 300, resetsAtMs: observedAtMs + 3_600_000 },
+  weekly: { usedPercent: 60, resetsAtMs: observedAtMs + 86_400_000 },
+};
+
+const accountA: ServerProviderAuth = {
+  status: "authenticated",
+  type: "accountLogin",
+  email: "Alice@Example.com",
+};
+const accountB: ServerProviderAuth = {
+  status: "authenticated",
+  type: "accountLogin",
+  email: "bob@example.com",
+};
+const labelOnly: ServerProviderAuth = {
+  status: "authenticated",
+  type: "accountLogin",
+  label: "Muse Code Power Usage",
+};
+
+it.layer(NodeServices.layer)("Muse usage disk cache", (it) => {
+  it.effect("writes atomically and reloads cached usage across restarts preserving observedAtMs", () =>
+    Effect.scoped(
+      Effect.gen(function* () {
+        const fs = yield* FileSystem.FileSystem;
+        const dir = yield* fs.makeTempDirectoryScoped({ prefix: "muse-usage-cache-" });
+
+        const writer = yield* makeMuseUsageCache({ cacheDir: dir, providerInstanceId: "muse" });
+        yield* writer.write(accountA, usage);
+        const path = yield* Path.Path;
+        const filePath = museUsageCacheFilePath(path, dir, "muse");
+        const stat = yield* fs.stat(filePath);
+        expect(stat.mode & 0o777).toBe(0o600);
+
+        // Fresh cache instance simulating a server reboot.
+        const reader = yield* makeMuseUsageCache({ cacheDir: dir, providerInstanceId: "muse" });
+        const restored = yield* reader.read(
+          { status: "authenticated", type: "accountLogin", email: "alice@example.com" },
+          observedAtMs + 1_000,
+        );
+        expect(restored).toEqual(usage);
+      }),
+    ),
+  );
+
+  it.effect("never caches or restores for label-only, API key, unknown, or signed-out accounts", () =>
+    Effect.scoped(
+      Effect.gen(function* () {
+        const fs = yield* FileSystem.FileSystem;
+        const path = yield* Path.Path;
+        const dir = yield* fs.makeTempDirectoryScoped({ prefix: "muse-usage-cache-" });
+        const cache = yield* makeMuseUsageCache({ cacheDir: dir, providerInstanceId: "muse" });
+
+        for (const auth of [
+          labelOnly,
+          { status: "authenticated", type: "apiKey", label: "API key" } as const,
+          { status: "unauthenticated" } as const,
+          { status: "unknown" } as const,
+        ]) {
+          expect(verifiedMuseAccountIdentity(auth)).toBeUndefined();
+          yield* cache.write(auth, usage);
+        }
+        const filePath = museUsageCacheFilePath(path, dir, "muse");
+        expect(yield* fs.exists(filePath)).toBe(false);
+      }),
+    ),
+  );
+
+  it.effect("drops and removes cached usage on account switch", () =>
+    Effect.scoped(
+      Effect.gen(function* () {
+        const fs = yield* FileSystem.FileSystem;
+        const path = yield* Path.Path;
+        const dir = yield* fs.makeTempDirectoryScoped({ prefix: "muse-usage-cache-" });
+        const cache = yield* makeMuseUsageCache({ cacheDir: dir, providerInstanceId: "muse" });
+
+        yield* cache.write(accountA, usage);
+        const restored = yield* cache.read(accountB, observedAtMs + 1_000);
+        expect(restored).toBeUndefined();
+        expect(yield* fs.exists(museUsageCacheFilePath(path, dir, "muse"))).toBe(false);
+      }),
+    ),
+  );
+
+  it.effect("drops expired entries once every window has reset and keeps partially active ones", () =>
+    Effect.scoped(
+      Effect.gen(function* () {
+        const fs = yield* FileSystem.FileSystem;
+        const path = yield* Path.Path;
+        const dir = yield* fs.makeTempDirectoryScoped({ prefix: "muse-usage-cache-" });
+        const cache = yield* makeMuseUsageCache({ cacheDir: dir, providerInstanceId: "muse" });
+
+        yield* cache.write(accountA, usage);
+        // Session window expired, weekly still active -> entry stays so weekly is preserved.
+        const partial = yield* cache.read(accountA, usage.window.resetsAtMs + 60_000);
+        expect(partial).toEqual(usage);
+
+        // Both windows expired -> dropped and removed.
+        const expired = yield* cache.read(accountA, usage.weekly.resetsAtMs + 60_000);
+        expect(expired).toBeUndefined();
+        expect(yield* fs.exists(museUsageCacheFilePath(path, dir, "muse"))).toBe(false);
+      }),
+    ),
+  );
+
+  it.effect("ignores corrupt JSON and mismatched schema version or providerInstanceId", () =>
+    Effect.scoped(
+      Effect.gen(function* () {
+        const fs = yield* FileSystem.FileSystem;
+        const path = yield* Path.Path;
+        const dir = yield* fs.makeTempDirectoryScoped({ prefix: "muse-usage-cache-" });
+        const cache = yield* makeMuseUsageCache({ cacheDir: dir, providerInstanceId: "muse-a" });
+        const filePath = museUsageCacheFilePath(path, dir, "muse-a");
+        yield* fs.makeDirectory(path.dirname(filePath), { recursive: true });
+
+        yield* fs.writeFileString(filePath, "{not valid json");
+        expect(yield* cache.read(accountA, observedAtMs + 1_000)).toBeUndefined();
+
+        yield* fs.writeFileString(
+          filePath,
+          JSON.stringify({
+            schemaVersion: 99,
+            providerInstanceId: "muse-a",
+            accountIdentity: "alice@example.com",
+            usage,
+          }),
+        );
+        expect(yield* cache.read(accountA, observedAtMs + 1_000)).toBeUndefined();
+
+        yield* fs.writeFileString(
+          filePath,
+          JSON.stringify({
+            schemaVersion: 1,
+            providerInstanceId: "muse-other",
+            accountIdentity: "alice@example.com",
+            usage,
+          }),
+        );
+        expect(yield* cache.read(accountA, observedAtMs + 1_000)).toBeUndefined();
+      }),
+    ),
+  );
+});
diff --git a/packages/provider-muse/src/server/usageCache.ts b/packages/provider-muse/src/server/usageCache.ts
new file mode 100644
index 0000000000..eba666766e
--- /dev/null
+++ b/packages/provider-muse/src/server/usageCache.ts
@@ -0,0 +1,143 @@
+// @effect-diagnostics nodeBuiltinImport:off -- atomic cache filenames use SHA-256 and UUIDs.
+import * as NodeCrypto from "node:crypto";
+
+import type { ServerProviderAuth } from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Path from "effect/Path";
+import * as Schema from "effect/Schema";
+
+import { MuseSubscriptionUsage } from "./protocol.ts";
+
+const CACHE_SCHEMA_VERSION = 1;
+const CACHE_SUBDIR = "muse-usage-limits";
+
+const MuseUsageCacheRecord = Schema.Struct({
+  schemaVersion: Schema.Literal(CACHE_SCHEMA_VERSION),
+  providerInstanceId: Schema.String,
+  accountIdentity: Schema.String,
+  usage: MuseSubscriptionUsage,
+});
+
+const CacheRecordJson = Schema.fromJsonString(MuseUsageCacheRecord);
+const decodeCacheRecord = Schema.decodeUnknownEffect(CacheRecordJson);
+const encodeCacheRecord = Schema.encodeEffect(CacheRecordJson);
+
+/**
+ * Only an authenticated account login with a verified email address may key
+ * the cross-restart disk cache. Display/plan labels alone are never trusted.
+ */
+export function verifiedMuseAccountIdentity(auth: ServerProviderAuth): string | undefined {
+  if (auth.status !== "authenticated" || auth.type !== "accountLogin") return undefined;
+  const email = auth.email?.trim().toLowerCase();
+  return email && email.length > 0 ? email : undefined;
+}
+
+export function museUsageCacheFilePath(
+  path: Path.Path,
+  cacheDir: string,
+  providerInstanceId: string,
+): string {
+  const hash = NodeCrypto.createHash("sha256").update(providerInstanceId).digest("hex").slice(0, 16);
+  return path.join(cacheDir, CACHE_SUBDIR, `${hash}.json`);
+}
+
+export interface MuseUsageCache {
+  readonly read: (
+    auth: ServerProviderAuth,
+    nowMs: number,
+  ) => Effect.Effect<MuseSubscriptionUsage | undefined>;
+  readonly write: (
+    auth: ServerProviderAuth,
+    usage: MuseSubscriptionUsage,
+  ) => Effect.Effect<void>;
+  readonly reconcileAuth: (auth: ServerProviderAuth) => Effect.Effect<void>;
+  readonly clear: Effect.Effect<void>;
+}
+
+export const makeMuseUsageCache = Effect.fn("MuseUsageCache.make")(function* (input: {
+  readonly cacheDir: string;
+  readonly providerInstanceId: string;
+}) {
+  const fileSystem = yield* FileSystem.FileSystem;
+  const path = yield* Path.Path;
+  const cachePath = museUsageCacheFilePath(path, input.cacheDir, input.providerInstanceId);
+  const cacheDir = path.dirname(cachePath);
+
+  const clear = fileSystem.remove(cachePath, { force: true }).pipe(Effect.ignore);
+
+  const reconcileAuth: MuseUsageCache["reconcileAuth"] = Effect.fn(
+    "MuseUsageCache.reconcileAuth",
+  )(function* (auth: ServerProviderAuth) {
+    if (auth.status === "unknown") return;
+    const identity = verifiedMuseAccountIdentity(auth);
+    // Clear any persisted file when Muse confirms signed-out, API key, or a label-only login.
+    if (identity === undefined) {
+      yield* clear;
+      return;
+    }
+    const raw = yield* fileSystem
+      .readFileString(cachePath)
+      .pipe(Effect.orElseSucceed(() => undefined));
+    if (raw === undefined) return;
+    const decoded = yield* decodeCacheRecord(raw).pipe(Effect.orElseSucceed(() => undefined));
+    if (decoded === undefined) return;
+    if (
+      decoded.providerInstanceId === input.providerInstanceId &&
+      decoded.accountIdentity !== identity
+    ) {
+      yield* clear;
+    }
+  });
+
+  const read: MuseUsageCache["read"] = Effect.fn("MuseUsageCache.read")(function* (
+    auth: ServerProviderAuth,
+    nowMs: number,
+  ) {
+    const identity = verifiedMuseAccountIdentity(auth);
+    if (identity === undefined) return undefined;
+    const raw = yield* fileSystem
+      .readFileString(cachePath)
+      .pipe(Effect.orElseSucceed(() => undefined));
+    if (raw === undefined) return undefined;
+    const decoded = yield* decodeCacheRecord(raw).pipe(Effect.orElseSucceed(() => undefined));
+    if (decoded === undefined) return undefined;
+    if (decoded.providerInstanceId !== input.providerInstanceId) return undefined;
+    if (decoded.accountIdentity !== identity) {
+      yield* clear;
+      return undefined;
+    }
+    const { usage } = decoded;
+    // Drop the cached entry once every reported window has already reset.
+    const hasUnexpiredWindow = usage.window.resetsAtMs > nowMs || usage.weekly.resetsAtMs > nowMs;
+    if (!hasUnexpiredWindow) {
+      yield* clear;
+      return undefined;
+    }
+    return usage;
+  });
+
+  const write: MuseUsageCache["write"] = Effect.fn("MuseUsageCache.write")(function* (
+    auth: ServerProviderAuth,
+    usage: MuseSubscriptionUsage,
+  ) {
+    const identity = verifiedMuseAccountIdentity(auth);
+    if (identity === undefined) return;
+    const payload = yield* encodeCacheRecord({
+      schemaVersion: CACHE_SCHEMA_VERSION,
+      providerInstanceId: input.providerInstanceId,
+      accountIdentity: identity,
+      usage,
+    }).pipe(Effect.orElseSucceed(() => undefined));
+    if (payload === undefined) return;
+    const tmpPath = `${cachePath}.${NodeCrypto.randomUUID()}.tmp`;
+    yield* fileSystem.makeDirectory(cacheDir, { recursive: true, mode: 0o700 }).pipe(
+      Effect.andThen(fileSystem.writeFileString(tmpPath, payload, { flag: "wx", mode: 0o600 })),
+      Effect.andThen(fileSystem.rename(tmpPath, cachePath)),
+      Effect.onError(() => fileSystem.remove(tmpPath, { force: true }).pipe(Effect.ignore)),
+      Effect.ignore,
+    );
+  });
+
+  return { read, write, reconcileAuth, clear } satisfies MuseUsageCache;
+});
