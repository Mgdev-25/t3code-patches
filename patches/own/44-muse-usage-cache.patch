diff --git a/packages/provider-muse/src/server/usageCache.test.ts b/packages/provider-muse/src/server/usageCache.test.ts
new file mode 100644
index 0000000000..b286a422f2
--- /dev/null
+++ b/packages/provider-muse/src/server/usageCache.test.ts
@@ -0,0 +1,157 @@
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import { expect, it } from "@effect/vitest";
+import type { ServerProviderAuth } from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Path from "effect/Path";
+
+import type { MuseSubscriptionUsage } from "./protocol.ts";
+import {
+  makeMuseUsageCache,
+  museUsageCacheFilePath,
+  verifiedMuseAccountIdentity,
+} from "./usageCache.ts";
+
+const observedAtMs = 1793073851130;
+const usage: MuseSubscriptionUsage = {
+  observedAtMs,
+  tier: "Muse Code Power Usage",
+  window: { usedPercent: 42, windowDurationMins: 300, resetsAtMs: observedAtMs + 3_600_000 },
+  weekly: { usedPercent: 60, resetsAtMs: observedAtMs + 86_400_000 },
+};
+
+const accountA: ServerProviderAuth = {
+  status: "authenticated",
+  type: "accountLogin",
+  email: "Alice@Example.com",
+};
+const accountB: ServerProviderAuth = {
+  status: "authenticated",
+  type: "accountLogin",
+  email: "bob@example.com",
+};
+const labelOnly: ServerProviderAuth = {
+  status: "authenticated",
+  type: "accountLogin",
+  label: "Muse Code Power Usage",
+};
+
+it.layer(NodeServices.layer)("Muse usage disk cache", (it) => {
+  it.effect("writes atomically and reloads cached usage across restarts preserving observedAtMs", () =>
+    Effect.scoped(
+      Effect.gen(function* () {
+        const fs = yield* FileSystem.FileSystem;
+        const dir = yield* fs.makeTempDirectoryScoped({ prefix: "muse-usage-cache-" });
+
+        const writer = yield* makeMuseUsageCache({ cacheDir: dir, providerInstanceId: "muse" });
+        yield* writer.write(accountA, usage);
+
+        // Fresh cache instance simulating a server reboot.
+        const reader = yield* makeMuseUsageCache({ cacheDir: dir, providerInstanceId: "muse" });
+        const restored = yield* reader.read(
+          { status: "authenticated", type: "accountLogin", email: "alice@example.com" },
+          observedAtMs + 1_000,
+        );
+        expect(restored).toEqual(usage);
+      }),
+    ),
+  );
+
+  it.effect("never caches or restores for label-only, API key, unknown, or signed-out accounts", () =>
+    Effect.scoped(
+      Effect.gen(function* () {
+        const fs = yield* FileSystem.FileSystem;
+        const path = yield* Path.Path;
+        const dir = yield* fs.makeTempDirectoryScoped({ prefix: "muse-usage-cache-" });
+        const cache = yield* makeMuseUsageCache({ cacheDir: dir, providerInstanceId: "muse" });
+
+        for (const auth of [
+          labelOnly,
+          { status: "authenticated", type: "apiKey", label: "API key" } as const,
+          { status: "unauthenticated" } as const,
+          { status: "unknown" } as const,
+        ]) {
+          expect(verifiedMuseAccountIdentity(auth)).toBeUndefined();
+          yield* cache.write(auth, usage);
+        }
+        const filePath = museUsageCacheFilePath(path, dir, "muse");
+        expect(yield* fs.exists(filePath)).toBe(false);
+      }),
+    ),
+  );
+
+  it.effect("drops and removes cached usage on account switch", () =>
+    Effect.scoped(
+      Effect.gen(function* () {
+        const fs = yield* FileSystem.FileSystem;
+        const path = yield* Path.Path;
+        const dir = yield* fs.makeTempDirectoryScoped({ prefix: "muse-usage-cache-" });
+        const cache = yield* makeMuseUsageCache({ cacheDir: dir, providerInstanceId: "muse" });
+
+        yield* cache.write(accountA, usage);
+        const restored = yield* cache.read(accountB, observedAtMs + 1_000);
+        expect(restored).toBeUndefined();
+        expect(yield* fs.exists(museUsageCacheFilePath(path, dir, "muse"))).toBe(false);
+      }),
+    ),
+  );
+
+  it.effect("drops expired entries once every window has reset and keeps partially active ones", () =>
+    Effect.scoped(
+      Effect.gen(function* () {
+        const fs = yield* FileSystem.FileSystem;
+        const path = yield* Path.Path;
+        const dir = yield* fs.makeTempDirectoryScoped({ prefix: "muse-usage-cache-" });
+        const cache = yield* makeMuseUsageCache({ cacheDir: dir, providerInstanceId: "muse" });
+
+        yield* cache.write(accountA, usage);
+        // Session window expired, weekly still active -> entry stays so weekly is preserved.
+        const partial = yield* cache.read(accountA, usage.window.resetsAtMs + 60_000);
+        expect(partial).toEqual(usage);
+
+        // Both windows expired -> dropped and removed.
+        const expired = yield* cache.read(accountA, usage.weekly.resetsAtMs + 60_000);
+        expect(expired).toBeUndefined();
+        expect(yield* fs.exists(museUsageCacheFilePath(path, dir, "muse"))).toBe(false);
+      }),
+    ),
+  );
+
+  it.effect("ignores corrupt JSON and mismatched schema version or providerInstanceId", () =>
+    Effect.scoped(
+      Effect.gen(function* () {
+        const fs = yield* FileSystem.FileSystem;
+        const path = yield* Path.Path;
+        const dir = yield* fs.makeTempDirectoryScoped({ prefix: "muse-usage-cache-" });
+        const cache = yield* makeMuseUsageCache({ cacheDir: dir, providerInstanceId: "muse-a" });
+        const filePath = museUsageCacheFilePath(path, dir, "muse-a");
+        yield* fs.makeDirectory(path.dirname(filePath), { recursive: true });
+
+        yield* fs.writeFileString(filePath, "{not valid json");
+        expect(yield* cache.read(accountA, observedAtMs + 1_000)).toBeUndefined();
+
+        yield* fs.writeFileString(
+          filePath,
+          JSON.stringify({
+            schemaVersion: 99,
+            providerInstanceId: "muse-a",
+            accountIdentity: "alice@example.com",
+            usage,
+          }),
+        );
+        expect(yield* cache.read(accountA, observedAtMs + 1_000)).toBeUndefined();
+
+        yield* fs.writeFileString(
+          filePath,
+          JSON.stringify({
+            schemaVersion: 1,
+            providerInstanceId: "muse-other",
+            accountIdentity: "alice@example.com",
+            usage,
+          }),
+        );
+        expect(yield* cache.read(accountA, observedAtMs + 1_000)).toBeUndefined();
+      }),
+    ),
+  );
+});
