@@ -0,0 +1,110 @@
+// @effect-diagnostics nodeBuiltinImport:off -- atomic cache filenames use SHA-256 and UUIDs.
+import * as NodeCrypto from "node:crypto";
+
+import type { ServerProviderAuth } from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Path from "effect/Path";
+import * as Schema from "effect/Schema";
+
+import { MuseSubscriptionUsage } from "./protocol.ts";
+
+const CACHE_SCHEMA_VERSION = 1;
+const CACHE_SUBDIR = "muse-usage-limits";
+
+const MuseUsageCacheRecord = Schema.Struct({
+  schemaVersion: Schema.Literal(CACHE_SCHEMA_VERSION),
+  providerInstanceId: Schema.String,
+  accountIdentity: Schema.String,
+  usage: MuseSubscriptionUsage,
+});
+
+const decodeCacheRecord = Schema.decodeUnknownEffect(Schema.fromJsonString(MuseUsageCacheRecord));
+
+/**
+ * Only an authenticated account login with a verified email address may key
+ * the cross-restart disk cache. Display/plan labels alone are never trusted.
+ */
+export function verifiedMuseAccountIdentity(auth: ServerProviderAuth): string | undefined {
+  if (auth.status !== "authenticated" || auth.type !== "accountLogin") return undefined;
+  const email = auth.email?.trim().toLowerCase();
+  return email && email.length > 0 ? email : undefined;
+}
+
+export function museUsageCacheFilePath(
+  path: Path.Path,
+  cacheDir: string,
+  providerInstanceId: string,
+): string {
+  const hash = NodeCrypto.createHash("sha256").update(providerInstanceId).digest("hex").slice(0, 16);
+  return path.join(cacheDir, CACHE_SUBDIR, `${hash}.json`);
+}
+
+export interface MuseUsageCache {
+  readonly read: (
+    auth: ServerProviderAuth,
+    nowMs: number,
+  ) => Effect.Effect<MuseSubscriptionUsage | undefined>;
+  readonly write: (
+    auth: ServerProviderAuth,
+    usage: MuseSubscriptionUsage,
+  ) => Effect.Effect<void>;
+  readonly clear: Effect.Effect<void>;
+}
+
+export const makeMuseUsageCache = Effect.fn("MuseUsageCache.make")(function* (input: {
+  readonly cacheDir: string;
+  readonly providerInstanceId: string;
+}): Effect.Effect<MuseUsageCache, never, FileSystem.FileSystem | Path.Path> {
+  const fileSystem = yield* FileSystem.FileSystem;
+  const path = yield* Path.Path;
+  const cachePath = museUsageCacheFilePath(path, input.cacheDir, input.providerInstanceId);
+  const cacheDir = path.dirname(cachePath);
+
+  const clear = fileSystem.remove(cachePath, { force: true }).pipe(Effect.ignore);
+
+  const read: MuseUsageCache["read"] = (auth, nowMs) =>
+    Effect.gen(function* () {
+      const identity = verifiedMuseAccountIdentity(auth);
+      if (identity === undefined) return undefined;
+      const raw = yield* fileSystem.readFileString(cachePath).pipe(Effect.orElseSucceed(() => undefined));
+      if (raw === undefined) return undefined;
+      const decoded = yield* decodeCacheRecord(raw).pipe(Effect.orElseSucceed(() => undefined));
+      if (decoded === undefined) return undefined;
+      if (decoded.providerInstanceId !== input.providerInstanceId) return undefined;
+      if (decoded.accountIdentity !== identity) {
+        yield* clear;
+        return undefined;
+      }
+      const { usage } = decoded;
+      // Drop the cached entry once every reported window has already reset.
+      const hasUnexpiredWindow =
+        usage.window.resetsAtMs > nowMs || usage.weekly.resetsAtMs > nowMs;
+      if (!hasUnexpiredWindow) {
+        yield* clear;
+        return undefined;
+      }
+      return usage;
+    });
+
+  const write: MuseUsageCache["write"] = (auth, usage) =>
+    Effect.gen(function* () {
+      const identity = verifiedMuseAccountIdentity(auth);
+      if (identity === undefined) return;
+      const payload = JSON.stringify({
+        schemaVersion: CACHE_SCHEMA_VERSION,
+        providerInstanceId: input.providerInstanceId,
+        accountIdentity: identity,
+        usage,
+      });
+      const tmpPath = `${cachePath}.${NodeCrypto.randomUUID()}.tmp`;
+      yield* fileSystem.makeDirectory(cacheDir, { recursive: true }).pipe(
+        Effect.andThen(fileSystem.writeFileString(tmpPath, payload)),
+        Effect.andThen(fileSystem.rename(tmpPath, cachePath)),
+        Effect.onError(() => fileSystem.remove(tmpPath, { force: true }).pipe(Effect.ignore)),
+        Effect.ignore,
+      );
+    });
+
+  return { read, write, clear } satisfies MuseUsageCache;
+});
