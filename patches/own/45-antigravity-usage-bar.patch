+          DateTime.toEpochMillis(DateTime.makeUnsafe("2026-10-21T10:00:00Z")),
+        );
+        let userInfoCalls = 0;
+        let resolvedUserId: string | undefined = undefined;
+        const { probe, clear, requests } = yield* fixture({
+          cliToken: {
+            access_token: "cli-access-1",
+            refresh_token: "cli-refresh-1",
+            expiry: "2026-10-21T11:00:00Z",
+          },
+          userId: () => {
+            userInfoCalls++;
+            return resolvedUserId;
+          },
+        });
+
+        // First read: userinfo fails transiently; fallback fingerprint must NOT be cached.
+        const first = yield* probe;
+        expect(first.unavailable).toBeUndefined();
+        expect(first.windows).toHaveLength(4);
+        expect(userInfoCalls).toBe(1);
+
+        // Second read: userinfo succeeds and gets cached.
+        resolvedUserId = "google-user-42";
+        const second = yield* probe;
+        expect(second.credentialFingerprint).toBeDefined();
+        expect(second.credentialFingerprint).not.toBe(first.credentialFingerprint);
+        expect(userInfoCalls).toBe(2);
+
+        // Third read: userinfo is served from cache with zero /userinfo HTTP requests.
+        const beforeCachedCount = requests.filter((r) => r.url.endsWith("/userinfo")).length;
+        const third = yield* probe;
+        expect(third.credentialFingerprint).toBe(second.credentialFingerprint);
+        expect(requests.filter((r) => r.url.endsWith("/userinfo")).length).toBe(beforeCachedCount);
+
