+          request,
+          userId
+            ? Response.json({ id: userId, email: "someone@example.com" })
+            : Response.json({}, { status: 403 }),
+        );
+      }
+      expect(JSON.parse(body)).toEqual(
+        options.cliToken || options.missingToken ? {} : { project: "project-id" },
