+  } = {},
+) {
+  const fs = yield* FileSystem.FileSystem;
+  const path = yield* Path.Path;
+  const profileDirectory = yield* fs.makeTempDirectoryScoped();
+  yield* fs.makeDirectory(path.join(profileDirectory, "antigravity-acp"));
+  const tokenPath = path.join(profileDirectory, "antigravity-acp", "acp_token.json");
+  const cliTokenPath = path.join(profileDirectory, "antigravity-acp", "antigravity-oauth-token");
+  const writeToken = (refreshToken: string) =>
+    fs.writeFileString(
+      tokenPath,
+      JSON.stringify({
+        client_id: "client-id",
+        client_secret: "client-secret",
+        refresh_token: refreshToken,
+        project_id: "project-id",
+      }),
+    );
+  const writeCliToken = (token: {
+    readonly access_token: string;
+    readonly refresh_token?: string;
+    readonly expiry?: string;
+  }) => fs.writeFileString(cliTokenPath, JSON.stringify({ token }));
+
+  if (options.cliToken) {
+    yield* writeCliToken(options.cliToken);
+  } else if (!options.missingToken) {
+    yield* writeToken(options.refreshToken ?? "refresh-a");
+  }
+
+  const requests: Array<{ url: string; body: string }> = [];
+  const http = HttpClient.make((request, url, _signal, fiber) =>
+    Effect.sync(() => {
+      const init = Context.getOrUndefined(fiber.context, FetchHttpClient.RequestInit);
+      expect(init?.redirect).toBe("manual");
+      const body =
+        request.body._tag === "Uint8Array" ? new TextDecoder().decode(request.body.body) : "";
+      requests.push({ url: request.url, body });
+      if (request.url.endsWith("/token")) {
+        expect(new URLSearchParams(body).get("grant_type")).toBe("refresh_token");
+        return HttpClientResponse.fromWeb(
+          request,
+          Response.json(
+            { access_token: "access-token", expires_in: 3600 },
+            { status: options.tokenStatus ?? 200 },
+          ),
+        );
+      }
+      expect(request.headers.authorization).toBe(
+        `Bearer ${options.cliToken?.access_token ?? "access-token"}`,
+      );
+      if (request.url.endsWith("/userinfo")) {
+        const userId =
+          typeof options.userId === "function" ? options.userId() : options.userId;
